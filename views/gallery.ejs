<!DOCTYPE html>
<html>

<head>
    <title>Photo Gallery</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>Photo Gallery</h1>
<form
    action="/gallery"
    method="GET"
>

<input
    type="text"
    name="search"
    placeholder="Search photos..."
    value="<%= search %>"
>

<button type="submit">

Search

</button>

  <% if (search) { %>

        <a href="/gallery">
            Clear
        </a>

    <% } %>

</form>

<p class="gallery-result-count">
    Found <%= totalPhotos %> photo(s)
</p>

<br>

<% if (photos.length === 0) { %>

    <p>No photos found.</p>

<% } else { %>

    <div class="gallery">

        <% photos.forEach(photo => { %>

            <div class="card">

                <a href="/photos/view/<%= photo._id %>">

                    <img
                        src="<%= photo.imageUrl %>"
                        alt="<%= photo.title %>"
                    >

                </a>

                <h2><%= photo.title %></h2>

                <p><%= photo.description %></p>

                <span>
                    <%= photo.category?.name || "No category" %>
                </span>

            </div>

        <% }) %>

    </div>

<% } %>

</div>

<% if (totalPages > 1) { %>

    <nav class="pagination">

        <% if (currentPage > 1) { %>

            <a
                href="/gallery?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>"
            >
                Previous
            </a>

        <% } %>

        <% for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) { %>

            <a
                href="/gallery?page=<%= pageNumber %>&search=<%= encodeURIComponent(search) %>"
                class="<%= pageNumber === currentPage ? 'active' : '' %>"
            >
                <%= pageNumber %>
            </a>

        <% } %>

        <% if (currentPage < totalPages) { %>

            <a
                href="/gallery?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>"
            >
                Next
            </a>

        <% } %>

    </nav>

<% } %>

</body>

</html>