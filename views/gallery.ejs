<!DOCTYPE html>
<html>

<head>
    <title>Photo Gallery</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>Photo Gallery</h1>
<form
    action="/gallery"
    method="GET"
>

<input
    type="text"
    name="search"
    placeholder="Search photos..."
    value="<%= search %>"
>

<button type="submit">

Search

</button>

</form>

<br>

<div class="gallery">

<% photos.forEach(photo => { %>

    <div class="card">

        <a href="/photos/view/<%= photo._id %>">

            <img
                src="<%= photo.imageUrl %>"
                alt="<%= photo.title %>"
            >

        </a>

        <h2><%= photo.title %></h2>

        <p><%= photo.description %></p>

        <span><%= photo.category.name %></span>

    </div>

<% }) %>

</div>

</body>

</html>