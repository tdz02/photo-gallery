<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Photo Gallery" %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <main class="gallery-page">

        <h1>Photo Gallery</h1>

        <!-- Search and sort -->
        <form
            action="/gallery"
            method="GET"
            class="gallery-toolbar"
        >

            <input
                type="text"
                name="search"
                placeholder="Search photos..."
                value="<%= search || "" %>"
            >

            <select
                name="sort"
                onchange="this.form.submit()"
            >

                <option
                    value="newest"
                    <%= sort === "newest" ? "selected" : "" %>
                >
                    Newest
                </option>

                <option
                    value="oldest"
                    <%= sort === "oldest" ? "selected" : "" %>
                >
                    Oldest
                </option>

                <option
                    value="title_asc"
                    <%= sort === "title_asc" ? "selected" : "" %>
                >
                    Title A-Z
                </option>

                <option
                    value="title_desc"
                    <%= sort === "title_desc" ? "selected" : "" %>
                >
                    Title Z-A
                </option>

            </select>

            <button type="submit">
                Search
            </button>

            <% if (search || sort !== "newest") { %>

                <a
                    href="/gallery"
                    class="reset-button"
                >
                    Reset
                </a>

            <% } %>

        </form>

        <!-- Result count -->
        <p class="gallery-result-count">

            Found <%= totalPhotos || 0 %>

            <%= totalPhotos === 1 ? "photo" : "photos" %>

        </p>

        <!-- Gallery content -->
        <% if (!photos || photos.length === 0) { %>

            <div class="empty-gallery">

                <p>No photos found.</p>

                <% if (search) { %>

                    <a href="/gallery">
                        View all photos
                    </a>

                <% } %>

            </div>

        <% } else { %>

            <div class="gallery">

                <% photos.forEach(photo => { %>

                    <article class="card">

                        <a
                            href="/photos/view/<%= photo._id %>"
                            class="card-image-link"
                        >

                            <img
                                src="<%= photo.imageUrl %>"
                                alt="<%= photo.title || "Photo" %>"
                                loading="lazy"
                                class="card-image"
                            >

                        </a>

                        <div class="card-content">

                            <h2>
                                <%= photo.title %>
                            </h2>

                            <% if (photo.description) { %>

                                <p>
                                    <%= photo.description %>
                                </p>

                            <% } %>

                            <span class="card-category">

                                <%= photo.category?.name || "No category" %>

                            </span>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>

            <nav
                class="pagination"
                aria-label="Gallery pagination"
            >

                <% if (currentPage > 1) { %>

                    <a
                        href="/gallery?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                    >
                        Previous
                    </a>

                <% } %>

                <% for (
                    let pageNumber = 1;
                    pageNumber <= totalPages;
                    pageNumber++
                ) { %>

                    <a
                        href="/gallery?page=<%= pageNumber %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                        class="<%= pageNumber === currentPage ? "active" : "" %>"
                        aria-current="<%= pageNumber === currentPage ? "page" : "false" %>"
                    >
                        <%= pageNumber %>
                    </a>

                <% } %>

                <% if (currentPage < totalPages) { %>

                    <a
                        href="/gallery?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                    >
                        Next
                    </a>

                <% } %>

            </nav>

        <% } %>

    </main>

</body>

</html>