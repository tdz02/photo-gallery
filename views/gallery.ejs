<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Photo Gallery" %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <main class="gallery-page">

        <h1>Photo Gallery</h1>

        <nav class="auth-navigation">

            <% if (currentUser) { %>

                <div class="auth-user-info">

                    <span>
                        Logged in as
                        <strong>
                            <%= currentUser.username %>
                        </strong>
                    </span>
                    <a href="/photos/mine">
                        My Photos
                    </a>

                    <a href="/photos/Upload">
                        Upload photo
                    </a>

                    <form
                        action="/auth/logout"
                        method="POST"
                        class="logout-form"
                    >
                        <button type="submit">
                            Log out
                        </button>
                    </form>

                </div>

            <% } else { %>

                <div class="auth-guest-links">

                    <a href="/auth/login">
                        Log in
                    </a>

                    <a href="/auth/register">
                        Register
                    </a>

                </div>

            <% } %>

        </nav>

        <!-- Search and sort -->
        <form
            action="/gallery"
            method="GET"
            class="gallery-toolbar"
        >

            <input
                type="text"
                name="search"
                placeholder="Search photos..."
                value="<%= search || "" %>"
            >

            <select
                name="sort"
                onchange="this.form.submit()"
            >

                <option
                    value="newest"
                    <%= sort === "newest" ? "selected" : "" %>
                >
                    Newest
                </option>

                <option
                    value="oldest"
                    <%= sort === "oldest" ? "selected" : "" %>
                >
                    Oldest
                </option>

                <option
                    value="title_asc"
                    <%= sort === "title_asc" ? "selected" : "" %>
                >
                    Title A-Z
                </option>

                <option
                    value="title_desc"
                    <%= sort === "title_desc" ? "selected" : "" %>
                >
                    Title Z-A
                </option>

            </select>

            <button type="submit">
                Search
            </button>

            <% if (search || sort !== "newest") { %>

                <a
                    href="/gallery"
                    class="reset-button"
                >
                    Reset
                </a>

            <% } %>

        </form>

        <!-- Result count -->
        <p class="gallery-result-count">

            Found <%= totalPhotos || 0 %>

            <%= totalPhotos === 1 ? "photo" : "photos" %>

        </p>

        <!-- Gallery content -->
        <% if (!photos || photos.length === 0) { %>

            <div class="empty-gallery">

                <p>No photos found.</p>

                <% if (search) { %>

                    <a href="/gallery">
                        View all photos
                    </a>

                <% } %>

            </div>

        <% } else { %>

            <div class="gallery">

                <% photos.forEach((photo) => { %>

                    <article class="card">

                        <a
                            href="/photos/view/<%= photo._id %>"
                            class="card-image-link"
                        >

                            <img
                                src="<%= photo.imageUrl %>"
                                alt="<%= photo.title || "Photo" %>"
                                loading="lazy"
                                class="card-image"
                            >

                        </a>

                        <div class="card-content">

                            <h2>
                                <%= photo.title %>
                            </h2>

                            <% if (photo.description) { %>

                                <p class="card-description">
                                    <%= photo.description %>
                                </p>

                            <% } %>

                            <span class="card-category">
                                <%= photo.category?.name || "No category" %>
                            </span>

                            <p>
                            Uploaded by
                            <strong>
                                <%= photo.owner?.username || "Unknown user" %>
                            </strong>
                             </p>
                             <%
                                const ownerId =
                                    photo.owner?._id?.toString() ||
                                    photo.owner?.toString();

                                const isOwner =
                                    currentUser &&
                                    ownerId === currentUser.id;
                            %>

                            <div class="card-actions">

                                <%
                                    const hasLiked =
                                    currentUser &&
                                    photo.likedBy &&
                                    photo.likedBy.some(
                                    (userId) =>
                                     userId.toString() === currentUser.id
                                    );
                                %>

                                <button
                                type="button"
                                class="like-button <%= hasLiked ? "is-liked" : "" %>"
                                data-id="<%= photo._id %>"
                                aria-label="Like <%= photo.title || "photo" %>"
                                aria-pressed="<%= hasLiked ? "true" : "false" %>"
                                <%= currentUser ? "" : "disabled" %>
                                >

                                    <svg
                                        class="like-icon"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M12 21s-7.2-4.35-9.45-8.7C.65 8.62 2.28 4 6.63 4A5.43 5.43 0 0 1 12 7.13 5.43 5.43 0 0 1 17.37 4c4.35 0 5.98 4.62 4.08 8.3C19.2 16.65 12 21 12 21Z"
                                        />
                                    </svg>

                                    

                                    <span
                                        class="like-count"
                                        id="likes-<%= photo._id %>"
                                    >
                                        <%= photo.likes || 0 %>
                                    </span>

                                </button>
                                <% if (isOwner) { %>

                                <a
                                    href="/photos/<%= photo._id %>/edit"
                                    class="edit-photo-button"
                                >
                                    Edit
                                </a>

                                <form
                                    action="/photos/<%= photo._id %>/delete"
                                    method="POST"
                                    class="delete-photo-form"
                                    onsubmit="return confirm('Delete this photo?');"
                                >

                                    <button
                                        type="submit"
                                        class="delete-photo-button"
                                    >
                                        Delete
                                    </button>

                                </form>

                            <% } %>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>

            <nav
                class="pagination"
                aria-label="Gallery pagination"
            >

                <% if (currentPage > 1) { %>

                    <a
                        href="/gallery?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                    >
                        Previous
                    </a>

                <% } %>

                <% for (
                    let pageNumber = 1;
                    pageNumber <= totalPages;
                    pageNumber++
                ) { %>

                    <a
                        href="/gallery?page=<%= pageNumber %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                        class="<%= pageNumber === currentPage ? "active" : "" %>"
                        aria-current="<%= pageNumber === currentPage ? "page" : "false" %>"
                    >
                        <%= pageNumber %>
                    </a>

                <% } %>

                <% if (currentPage < totalPages) { %>

                    <a
                        href="/gallery?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || "") %>&sort=<%= sort || "newest" %>"
                    >
                        Next
                    </a>

                <% } %>

            </nav>

        <% } %>

    </main>

    <script>
        const likeButtons = document.querySelectorAll(".like-button");

        likeButtons.forEach((button) => {
            button.addEventListener("click", async () => {
                const photoId = button.dataset.id;

                const likeCount = document.getElementById(
                    `likes-${photoId}`
                );

                if (button.disabled) {
                    return;
                }

                button.disabled = true;
                button.classList.add("is-loading");

                try {
                    const response = await fetch(
                        `/photos/${photoId}/like`,
                        {
                            method: "POST",
                            headers: {
                                Accept: "application/json"
                            }
                        }
                    );

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(
                            data.message || "Could not like photo"
                        );
                    }

                    likeCount.textContent = data.likes;

                    button.classList.toggle(
                        "is-liked",
                        data.liked
                    );

                    button.setAttribute(
                        "aria-pressed",
                        data.liked ? "true" : "false"
                    );

                    button.classList.remove("like-animation");

                    void button.offsetWidth;

                    button.classList.add("like-animation");
                } catch (error) {
                    console.error("Like error:", error);

                    button.classList.add("has-error");

                    setTimeout(() => {
                        button.classList.remove("has-error");
                    }, 1000);
                } finally {
                    button.disabled = false;
                    button.classList.remove("is-loading");
                }
            });
        });
    </script>

</body>

</html>