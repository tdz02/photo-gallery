<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Edit Photo</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="container">

<h1>Edit Photo</h1>

<form
    action="/photos/<%= photo._id %>?_method=PUT"
    method="POST"
>

    <div>

        <label>Title</label>

        <input
            type="text"
            name="title"
            value="<%= photo.title %>"
            required
        >

    </div>

    <br>

    <div>

        <label>Description</label>

        <textarea
            name="description"
            rows="4"
            required
        ><%= photo.description %></textarea>

    </div>

    <br>

    <div>

        <label>Category</label>

        <select name="category">

            <% categories.forEach(category => { %>

                <option
                    value="<%= category._id %>"
                    <%= category._id.toString() === photo.category._id.toString()
                        ? "selected"
                        : "" %>
                >

                    <%= category.name %>

                </option>

            <% }) %>

        </select>

    </div>

    <br>

    <button type="submit">

        Save Changes

    </button>

</form>

</div>

</body>

</html>